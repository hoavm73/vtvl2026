# ==============================================================================
# CẤU HÌNH HỆ THỐNG HCM-UTE VTVL 360 (PostgreSQL 16 + Prisma ORM + NextAuth)
# Sao chép tệp này thành .env trên máy chủ VPS (tuyệt đối không commit .env)
# ==============================================================================

# 1. Tên miền ứng dụng chính thức
NEXT_PUBLIC_APP_URL=https://kekhaivtvl.hcmute.edu.vn
NEXTAUTH_URL=https://kekhaivtvl.hcmute.edu.vn
NEXTAUTH_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu
ADMIN_SERVER_SECRET=thay-bang-chuoi-ngau-nhien-48-ky-tu

# 2. Google OAuth 2.0 (NextAuth GoogleProvider + PrismaAdapter)
# Thêm các Authorized JavaScript origins & Redirect URIs trong Google Cloud Console:
#   Origins:
#     - https://kekhaivtvl.hcmute.edu.vn
#     - https://vtvl.utehub.vn
#   Redirect URIs:
#     - https://kekhaivtvl.hcmute.edu.vn/api/auth/callback/google
#     - https://vtvl.utehub.vn/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Để trống để cho phép cả tài khoản @hcmute.edu.vn và tài khoản đã khai báo trong user_accounts
GOOGLE_ALLOWED_HD=

# 3. Cơ sở dữ liệu PostgreSQL 16 độc lập (Prisma ORM)
POSTGRES_USER=utevtvl_admin
POSTGRES_PASSWORD=thay-bang-mat-khau-manh-postgresql
POSTGRES_DB=utevtvl_db
DATABASE_URL=postgresql://utevtvl_admin:thay-bang-mat-khau-manh-postgresql@127.0.0.1:5436/utevtvl_db?schema=public
