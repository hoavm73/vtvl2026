{
  "name": "hcmute-vtvl-360",
  "version": "2.0.0",
  "private": true,
  "description": "Hệ thống Vị trí việc làm 360 - Trường Đại học Công nghệ Kỹ thuật TP.HCM (HCM-UTE)",
  "scripts": {
    "dev": "next dev -p 3360",
    "build": "prisma generate && next build",
    "start": "next start -p 3360",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:verify": "node scripts/verify-deployed-tables.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "node tests/vtvl-workflow.test.mjs && node tests/security-stress-rls.test.mjs && node tests/schema-reconciliation.test.mjs && node tests/rbac-matrix.test.mjs && node tests/work-survey-lifecycle.test.mjs && node tests/work-survey-versioning.test.mjs && node tests/vtvl-coordinated-proposals.test.mjs && node tests/unit-code-migration-p0.test.mjs",
    "test:security": "node tests/security-stress-rls.test.mjs",
    "test:schema": "node tests/schema-reconciliation.test.mjs",
    "test:rbac": "node tests/rbac-matrix.test.mjs",
    "test:lifecycle": "node tests/work-survey-lifecycle.test.mjs",
    "test:versioning": "node tests/work-survey-versioning.test.mjs",
    "test:coordinated": "node tests/vtvl-coordinated-proposals.test.mjs",
    "test:unit-migration": "node tests/unit-code-migration-p0.test.mjs",
    "generate:templates": "node scripts/generate-templates.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
